# ==============================================================================
# Aerial Secrets Template (.env)
# Copy this file to .env on your host machine and populate your credentials.
# DO NOT COMMIT .env TO VERSION CONTROL!
# ==============================================================================

# 1. AI Inference Authentication
# RECOMMENDED: Leave GEMINI_API_KEY commented out if using Google OAuth authentication.
# Alternatively, provide your API key from Google AI Studio (https://aistudio.google.com/):
# GEMINI_API_KEY=your_gemini_api_key_here

# 2. Discord Bot Credentials (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 3. GitHub Personal Access Token (for private repository sync & GitHub MCP)
GITHUB_PAT=your_github_personal_access_token_here

# 4. Web UI & AgentsView Access Configuration
AGENTSVIEW_PUBLIC_URL=http://localhost:8089
AGENTSVIEW_PUBLIC_ORIGINS=http://localhost:8089,http://127.0.0.1:8089

# 5. Optional Custom MCP API Keys & Sidecar Tokens
BRAVE_API_KEY=your_brave_search_api_key_here
